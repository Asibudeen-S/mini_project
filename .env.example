SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///attendance.db
# Optional, for MySQL: mysql+pymysql://user:password@localhost/attendance
# Set FLASK_DEBUG=1 only for local development.
FLASK_DEBUG=0
COOKIE_SECURE=0
# Set COOKIE_SECURE=1 when serving the app over HTTPS.
# These seed passwords apply to demo accounts; an existing admin password is preserved.
SEED_ADMIN_PASSWORD=ChangeThisBeforeDeploying123!
SEED_DEMO_PASSWORD=DemoPassword123!
SEED_STUDENT_PASSWORD=StudentDemo123!
